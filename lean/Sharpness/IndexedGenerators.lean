import Sharpness.NormalForms

/-! The subfunctor generated by an arbitrary indexed family of vectors.
Closure is proved from the full Mackey normal-form composition formula. -/
set_option autoImplicit false
noncomputable section
universe u v w t
namespace Sharpness.MackeyModule
open CategoryTheory
variable {R : Type u} [Ring R] {C : Type v} [Category.{v} C]
    {B : MackeyShape C} (M : MackeyModule.{u,v,w} R C B)
    {I : Type t} (source : I → C) (vector : ∀ i, M.Value (source i))

def indexedGeneratorSet (T : C) : Set (M.Value T) :=
  {y | ∃ i, ∃ s : MackeySpan C (source i) T, M.normalMap s (vector i) = y}

def indexedGeneratedValue (T : C) : Submodule R (M.Value T) :=
  Submodule.span R (M.indexedGeneratorSet source vector T)

theorem normalMap_mem_indexedGeneratedValue {P T : C} (b : MackeySpan C P T)
    {x : M.Value P} (hx : x ∈ M.indexedGeneratedValue source vector P) :
    M.normalMap b x ∈ M.indexedGeneratedValue source vector T := by
  have h : M.indexedGeneratedValue source vector P ≤
      (M.indexedGeneratedValue source vector T).comap (M.normalMap b) := by
    apply Submodule.span_le.mpr
    intro y hy
    obtain ⟨i, a, rfl⟩ := hy
    change M.normalMap b (M.normalMap a (vector i)) ∈ M.indexedGeneratedValue source vector T
    have he := LinearMap.congr_fun (M.normalMap_comp a b) (vector i)
    simp only [LinearMap.comp_apply, LinearMap.sum_apply] at he
    rw [he]
    apply Submodule.sum_mem
    intro j _
    exact Submodule.subset_span ⟨i, normalCompositeTerm (B := B) a b j, rfl⟩
  exact h hx

def indexedGeneratedSubfunctor : M.Subfunctor where
  obj := M.indexedGeneratedValue source vector
  pull_closed := by
    intro P T f x hx
    rw [M.pull_is_normal f]
    exact M.normalMap_mem_indexedGeneratedValue source vector _ hx
  push_closed := by
    intro P T f x hx
    rw [M.push_is_normal f]
    exact M.normalMap_mem_indexedGeneratedValue source vector _ hx

theorem mem_indexedGeneratedValue (i : I) : vector i ∈ M.indexedGeneratedValue source vector (source i) := by
  apply Submodule.subset_span
  refine ⟨i, ⟨source i, 𝟙 _, 𝟙 _⟩, ?_⟩
  simp only [normalMap, M.pull_id, M.push_id, LinearMap.id_comp, LinearMap.id_apply]

end Sharpness.MackeyModule
