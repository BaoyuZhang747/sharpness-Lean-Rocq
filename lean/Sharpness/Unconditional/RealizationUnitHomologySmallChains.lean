import Sharpness.SingularCochains
import Mathlib.AlgebraicTopology.SimplicialSet.TopAdj
import Mathlib.AlgebraicTopology.SimplicialSet.Subcomplex

/-! Actual small singular simplices and their chain complexes. These definitions
are the domain of the subdivision/excision argument; the homology equivalence
of the inclusion for an open cover is not assumed. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.defeqAttrib.useBackward true
noncomputable section
universe u v w
namespace Sharpness.RealizationUnitHomology
open CategoryTheory CategoryTheory.Limits Simplicial Opposite

variable (X : TopCat.{u}) {ι : Type v} (U : ι → Set X)

/-- Singular simplices whose entire image lies in one member of a family. -/
def singularSmallSubcomplex : (TopCat.toSSet.obj X).Subcomplex where
  obj m := {σ | ∃ i, ∀ t, X.toSSetObjEquiv m σ t ∈ U i}
  map {m n} f σ hσ := by
    obtain ⟨i, hi⟩ := hσ
    refine ⟨i, fun t => ?_⟩
    exact hi (_root_.stdSimplex.map f.unop t)

@[simp] theorem mem_singularSmallSubcomplex (m : SimplexCategoryᵒᵖ)
    (σ : (TopCat.toSSet.obj X).obj m) :
    σ ∈ (singularSmallSubcomplex X U).obj m ↔
      ∃ i, ∀ t, X.toSSetObjEquiv m σ t ∈ U i := Iff.rfl

/-- Refining a family gives an actual inclusion of small-singular subcomplexes. -/
theorem singularSmallSubcomplex_refinement {κ : Type w} (V : κ → Set X)
    (hUV : ∀ i, ∃ j, U i ⊆ V j) :
    singularSmallSubcomplex X U ≤ singularSmallSubcomplex X V := by
  intro m σ hσ
  obtain ⟨i, hi⟩ := hσ
  obtain ⟨j, hj⟩ := hUV i
  exact ⟨j, fun t => hj (hi t)⟩

/-- A family containing the whole space imposes no smallness condition. -/
theorem singularSmallSubcomplex_eq_top (i : ι) (hi : U i = Set.univ) :
    singularSmallSubcomplex X U = ⊤ := by
  apply le_antisymm le_top
  intro m σ _
  exact ⟨i, fun _ => hi ▸ Set.mem_univ _⟩

/-- Every vertex is small for a covering family. -/
theorem singularSmallSubcomplex_zero (hU : ∀ x : X, ∃ i, x ∈ U i)
    (σ : (TopCat.toSSet.obj X).obj (op ⦋0⦌)) :
    σ ∈ (singularSmallSubcomplex X U).obj (op ⦋0⦌) := by
  obtain ⟨i, hi⟩ := hU (X.toSSetObjEquiv _ σ (_root_.stdSimplex.vertex 0))
  refine ⟨i, fun t => ?_⟩
  simpa only [Subsingleton.elim t (_root_.stdSimplex.vertex 0)] using hi

/-- The small-simplex inclusion is a bijection on actual vertices of a cover. -/
theorem singularSmallSubcomplex_zero_isIso (hU : ∀ x : X, ∃ i, x ∈ U i) :
    IsIso ((singularSmallSubcomplex X U).ι.app (op ⦋0⦌)) := by
  apply (CategoryTheory.isIso_iff_bijective _).mpr
  constructor
  · exact Subtype.val_injective
  · intro σ
    exact ⟨⟨σ, singularSmallSubcomplex_zero X U hU σ⟩, rfl⟩

variable (R : Type u) [CommRing R]

/-- The actual chain complex generated by small singular simplices. -/
abbrev smallSingularChains : ChainComplex (ModuleCat.{u} R) ℕ :=
  SSet.chainComplex (singularSmallSubcomplex X U).toSSet (ModuleCat.of R R)

/-- The inclusion into the native singular-chain complex. -/
def smallSingularChainsInclusion : smallSingularChains X U R ⟶
    (SingularCohomology.chainsFunctor R).obj X :=
  SSet.chainComplexMap (singularSmallSubcomplex X U).ι (ModuleCat.of R R)

/-- On each generator, the inclusion sends the actual restricted simplex to
the same singular simplex. -/
@[reassoc] theorem smallSingularChainsInclusion_generator (n : ℕ)
    (σ : (singularSmallSubcomplex X U).obj (op ⦋n⦌)) :
    (singularSmallSubcomplex X U).toSSet.ιChainComplex (R := ModuleCat.of R R) σ ≫
      (smallSingularChainsInclusion X U R).f n =
        (TopCat.toSSet.obj X).ιChainComplex (R := ModuleCat.of R R) σ.1 :=
  SSet.ι_chainComplexMap_f _ _ _ _ _

end Sharpness.RealizationUnitHomology
